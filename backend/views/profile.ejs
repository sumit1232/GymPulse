<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Profile</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        .profile-card { box-shadow: 0 20px 60px rgba(0,0,0,0.15); border: none; }
        .avatar { width: 120px; height: 120px; object-fit: cover; }
        .stats-card { background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); }
    </style>
</head>
<body class="bg-light">
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
        <div class="container">
            <a class="navbar-brand fw-bold" href="#"><i class="fas fa-user-circle me-2"></i>MyApp</a>
            <div class="navbar-nav ms-auto">
                <a class="nav-link" href="profile.html"><i class="fas fa-user me-1"></i>Profile</a>
               <a href="/logout"> <button id="logoutBtn" class="btn btn-outline-light ms-2"><i class="fas fa-sign-out-alt me-1"></i>Logout</button> </a>
            </div>
        </div>
    </nav>

    <div class="container py-5">
        <div class="row justify-content-center">
            <!-- Main Profile Card -->
            <div class="col-lg-8 col-xl-6">
                <div class="card profile-card rounded-4 overflow-hidden">
                    <div class="bg-primary text-white p-4 text-center">
                        <img src="https://ui-avatars.com/api/?name=John+Doe&size=120&background=667eea&color=fff" 
                             alt="Avatar" class="rounded-circle avatar mb-3 shadow">
                        <h2 id="profileName" class="fw-bold mb-1"><%= data.name %></h2>
                        <p id="profileEmail" class="mb-2 opacity-75"><%= data.email %></p>
                        <span id="profileAge" class="badge bg-light text-primary px-3 py-2">25 years old</span>
                    </div>
                    
                    <div class="card-body p-5">
                        <div class="row text-center mb-4">
                            <div class="col-4">
                                <h3 id="memberSince" class="fw-bold text-primary">Jan 2026</h3>
                                <p class="text-muted mb-0">Member Since</p>
                            </div>
                            <div class="col-4">
                                <h3 class="fw-bold text-success">Active</h3>
                                <p class="text-muted mb-0">Status</p>
                            </div>
                            <div class="col-4">
                                <h3 class="fw-bold text-info">Verified</h3>
                                <p class="text-muted mb-0">Account</p>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div id="message" class="alert mt-3 d-none" role="alert"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>