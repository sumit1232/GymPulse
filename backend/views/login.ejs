<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        .login-card { box-shadow: 0 20px 40px rgba(0,0,0,0.1); }
        .btn-login { background: linear-gradient(45deg, #667eea 0%, #764ba2 100%); border: none; }
        .btn-login:hover { transform: translateY(-2px); }
    </style>
</head>
<body class="bg-gradient" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); min-height: 100vh;">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-xl-5">
                <div class="card login-card border-0 rounded-4 overflow-hidden">
                    <div class="row g-0">
                        <div class="col-md-6 d-flex align-items-center justify-content-center p-5 bg-primary text-white">
                            <div>
                                <h2 class="fw-bold mb-4">Welcome Back!</h2>
                                <p class="lead mb-0">Login to your account</p>
                            </div>
                        </div>
                        <div class="col-md-6 p-5">
                            <h3 class="fw-bold mb-4 text-center">Login</h3>
                            
                            <form action="/loginuser" method="post">
                                <div class="mb-4">
                                    <label for="email" class="form-label fw-semibold">Email</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-envelope"></i></span>
                                        <input type="email" class="form-control" id="email" name="email" required 
                                               placeholder="your@email.com">
                                    </div>
                                    <div class="invalid-feedback">Please enter valid email.</div>
                                </div>

                                <div class="mb-4">
                                    <label for="password" class="form-label fw-semibold">Password</label>
                                    <div class="input-group">
                                        <span class="input-group-text"><i class="fas fa-lock"></i></span>
                                        <input type="password" class="form-control" id="password" name="password" required 
                                               minlength="6" placeholder="Enter password">
                                        <button class="btn btn-outline-secondary" type="button" id="togglePassword">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                    </div>
                                    <div class="invalid-feedback">Password required.</div>
                                </div>

                                <div class="mb-4 form-check">
                                    <input type="checkbox" class="form-check-input" id="remember">
                                    <label class="form-check-label" for="remember">
                                        Remember me
                                    </label>
                                </div>

                                <button type="submit" class="btn btn-login btn-lg w-100 text-white mb-3">
                                    <i class="fas fa-sign-in-alt me-2"></i>Login
                                </button>

                                <div id="message" class="alert d-none mb-3" role="alert"></div>
                            </form>

                            <div class="text-center">
                                <p class="mb-0">Don't have account? <a href="index.html" class="text-decoration-none fw-bold">Register here</a></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>