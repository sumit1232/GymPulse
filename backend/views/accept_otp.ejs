<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Enter OTP</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet">
    <style>
        .otp-box {
            width: 55px; 
            height: 55px; 
            font-size: 1.4rem; 
            text-align: center; 
            border: 2px solid #dee2e6; 
            border-radius: 10px; 
            font-weight: 600;
        }
        .otp-box:focus {
            border-color: #0d6efd;
            box-shadow: 0 0 0 0.2rem rgba(13,110,253,.25);
        }
        body { 
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
        }
        .otp-container {
            max-width: 420px;
        }
    </style>
</head>
<body class="d-flex align-items-center py-5">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-6 col-lg-5 col-xl-4">
                <div class="card shadow-lg border-0 rounded-4 otp-container">
                    <div class="card-body p-5 text-center">
                        <!-- Header -->
                        <div class="mb-5">
                            <div class="bg-primary bg-opacity-10 rounded-circle mx-auto p-4 mb-4" style="width: 90px; height: 90px;">
                                <i class="fas fa-mobile-alt text-primary fs-1"></i>
                            </div>
                            <h3 class="fw-bold mb-2">Enter OTP Code</h3>
                            <p class="text-muted mb-0">We sent 4-digit code to your email</p>
                            <small class="text-muted d-block mt-1">your.email@example.com</small>
                        </div>

                        <!-- OTP Form -->
                        <form action="/verifyotp" method="POST">
                            <!-- Hidden fields -->
                            <input type="hidden" name="email" value="user@example.com">
                            
                            <!-- 4 Digit OTP Inputs -->
                            <div class="d-flex justify-content-center gap-3 mb-4">
                                <input type="text" 
                                       id="digit1" 
                                       name="otp1" 
                                       class="otp-box form-control" 
                                       maxlength="1" 
                                       required 
                                       pattern="[0-9]{1}">
                                <input type="text" 
                                       id="digit2" 
                                       name="otp2" 
                                       class="otp-box form-control" 
                                       maxlength="1" 
                                       required 
                                       pattern="[0-9]{1}">
                                <input type="text" 
                                       id="digit3" 
                                       name="otp3" 
                                       class="otp-box form-control" 
                                       maxlength="1" 
                                       required 
                                       pattern="[0-9]{1}">
                                <input type="text" 
                                       id="digit4" 
                                       name="otp4" 
                                       class="otp-box form-control" 
                                       maxlength="1" 
                                       required 
                                       pattern="[0-9]{1}">
                            </div>

                            <!-- Submit Button -->
                            <button type="submit" class="btn btn-primary btn-lg w-100 fw-bold py-3 mb-4">
                                <i class="fas fa-check-circle me-2"></i>Verify Code
                            </button>

                            <!-- Bottom Links -->
                            <div class="d-flex justify-content-between">
                                <a href="register.html" class="btn btn-link btn-sm p-0 text-muted">
                                    <i class="fas fa-arrow-left me-1"></i>Back
                                </a>
                                <a href="#" class="btn btn-link btn-sm p-0 text-primary">
                                    Resend Code
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>